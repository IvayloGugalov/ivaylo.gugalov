{
  "name": "portfolio-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "auth:generate": "bunx @better-auth/cli generate",
    "lint": "biome lint --write src/.",
    "format": "biome format --write src/.",
    "check": "biome check --write src/.",
    "i18n:compile": "bunx @inlang/paraglide-js compile --project ./project.inlang --outdir ./src/paraglide",
    "i18n:lint": "bunx @inlang/cli@latest lint --project ./project.inlang",
    "i18n:export": "bunx @inlang/cli@latest export --project ./project.inlang --plugin-id plugin.inlang.messageFormat --outdir ./translations/",
    "i18n:import": "bunx @inlang/cli@latest import --project ./project.inlang --plugin-id plugin.inlang.messageFormat"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/geist-sans": "^5.2.5",
    "@gsap/react": "^2.1.2",
    "@inlang/paraglide-js": "^2.18.1",
    "@mdx-js/mdx": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@neondatabase/serverless": "^1.1.0",
    "@octokit/rest": "^22.0.1",
    "@orpc/client": "^1.14.3",
    "@orpc/react-query": "^1.14.3",
    "@orpc/server": "^1.14.3",
    "@orpc/zod": "^1.14.3",
    "@posthog/react": "^1.9.1",
    "@shikijs/rehype": "^4.1.0",
    "@t3-oss/env-core": "^0.13.11",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/pacer": "^0.21.1",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-query": "^5.100.14",
    "@tanstack/react-router": "^1.170.8",
    "@tanstack/react-router-devtools": "^1.167.0",
    "@tanstack/react-router-ssr-query": "^1.167.0",
    "@tanstack/react-start": "^1.168.14",
    "@tanstack/react-start-rsc": "^0.1.13",
    "@tanstack/router-plugin": "^1.168.11",
    "better-auth": "^1.6.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "gray-matter": "^4.0.3",
    "gsap": "^3.15.0",
